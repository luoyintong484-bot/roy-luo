# Existing application variables
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
APP_ID=
APP_SECRET=

# Public origin used to build Alipay callback URLs. No trailing slash.
PUBLIC_SITE_URL=https://www.r7fortune.com

# Alipay computer website payment (RSA2)
# Keep disabled until APP_ID, keys, HTTPS callbacks and DB migration are ready.
ALIPAY_ENABLED=false
ALIPAY_WAP_ENABLED=false
ALIPAY_APP_ID=2026XXXXXXXXXXXX
# Prefer file paths on the server. The inline variables below are fallback only.
ALIPAY_APP_PRIVATE_KEY_FILE=/www/server/secrets/r7fortune/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=/www/server/secrets/r7fortune/alipay_public_key.pem
ALIPAY_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional but recommended: validate that notifications belong to this seller.
ALIPAY_SELLER_ID=
