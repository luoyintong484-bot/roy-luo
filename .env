# R7 Fortune — Environment Configuration
# Kimi / Moonshot AI Platform
KIMI_AUTH_URL=https://open.moonshot.cn
KIMI_OPEN_URL=https://api.moonshot.cn

# Moonshot AI API Key (for synastry AI report generation)
# Get your key from: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# App credentials (set your own values)
APP_ID=
APP_SECRET=

# Database (MySQL)
DATABASE_URL=

# Optional: owner user ID
OWNER_UNION_ID=

# Test auth bypass (set to "true" to enable mock login for testing)
# Remove or set to "false" to restore real auth
TEST_AUTH=true
