export interface ArtistStatic {
  id: number;
  name: string;
  nameKr?: string;
  stageName: string;
  groupName: string;
  region: "korea" | "china" | "japan";
  gender: "male" | "female";
  category: "girlGroup" | "boyGroup" | "solo";
  birthDate: string;
  lunarBirth?: string;
  birthTime: string;
  birthPlace: string;
  zodiacSign: string;
  zodiacMoon: string;
  baziYearPillar?: string;
  baziMonthPillar?: string;
  baziDayPillar: string;
  baziHourPillar?: string;
  starMansion: string;
  chineseZodiac: string;
  element: string;
  mbti: string;
  debutDate: string;
  agency: string;
  position: string;
  avatar?: string;
  cpHeat?: number;          // CP heat index 0-100 from multi-source crawler
  cpPair?: string;          // CP pair name (e.g. "元彬×Anton")
}

const CHINESE_ZODIAC_MAP: Record<number, string> = {
  0: "猴", 1: "鸡", 2: "狗", 3: "猪", 4: "鼠", 5: "牛",
  6: "虎", 7: "兔", 8: "龙", 9: "蛇", 10: "马", 11: "羊",
};

function getChineseZodiac(year: number): string {
  return CHINESE_ZODIAC_MAP[year % 12] || "?";
}

