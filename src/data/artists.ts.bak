// Merge all
export const ALL_ARTISTS: ArtistStatic[] = [...KOREAN_ARTISTS, ...CHINESE_ARTISTS];

// Group by groupName
export function getGroupedArtists(filterRegion?: string, searchQuery?: string) {
  let data = [...ALL_ARTISTS];

  if (filterRegion && filterRegion !== "all") {
    if (filterRegion === "tf") {
      data = data.filter(a => a.agency?.includes("时代峰峻"));
    } else if (filterRegion === "other") {
      data = data.filter(a => a.region !== "korea" && !a.agency?.includes("时代峰峻"));
    } else {
      data = data.filter(a => a.region === filterRegion);
    }
  }

  if (searchQuery?.trim()) {
    const q = searchQuery.trim().toLowerCase();
    data = data.filter(a =>
      a.name.toLowerCase().includes(q) ||
      a.stageName.toLowerCase().includes(q) ||
      a.groupName.toLowerCase().includes(q) ||
      a.birthDate.includes(q) ||
      a.zodiacSign.includes(q) ||
      a.mbti.toLowerCase().includes(q)
    );
  }

  const grouped: Record<string, ArtistStatic[]> = {};
  for (const artist of data) {
    const g = artist.groupName || "个人";
    if (!grouped[g]) grouped[g] = [];
    grouped[g].push(artist);
  }

  // Sort within each group by cpHeat (highest first), then by id
  for (const g of Object.keys(grouped)) {
    grouped[g].sort((a, b) => (b.cpHeat || 0) - (a.cpHeat || 0) || a.id - b.id);
  }

  const sortedEntries = Object.entries(grouped).sort((a, b) => {
    // Groups with high-CP-heat members first
    const aMaxHeat = Math.max(...a[1].map(x => x.cpHeat || 0));
    const bMaxHeat = Math.max(...b[1].map(x => x.cpHeat || 0));
    if (aMaxHeat !== bMaxHeat) return bMaxHeat - aMaxHeat;
    const aKorea = a[1][0]?.region === "korea" ? 0 : 1;
    const bKorea = b[1][0]?.region === "korea" ? 0 : 1;
    return aKorea - bKorea || a[0].localeCompare(b[0]);
  });

  return sortedEntries;
}

export function getArtistById(id: number): ArtistStatic | undefined {
  return ALL_ARTISTS.find(a => a.id === id);
}

